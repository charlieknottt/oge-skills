{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oge/skills/world-graph-builder/graph.schema.json",
  "title": "OGE World Graph (lean runtime graph)",
  "description": "The runtime context document the live game uses and the Game Manager approves. Matches examples/gordian_knot_graph.json and examples/taiwan_strait_graph.json.",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "scenario": { "type": "string", "description": "scenario slug, e.g. gordian_knot (optional)" },
    "version": { "type": "string", "description": "graph version string (optional)" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "label", "category", "type", "starting_value", "inverted"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "unique snake_case identifier"
        },
        "label": { "type": "string", "minLength": 1, "description": "human-readable name" },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "functional swimlane grouping (scenario-specific, e.g. Levers/Supply/Compromise/Outcomes). NOT necessarily a PMESII-P dimension."
        },
        "type": {
          "type": "string",
          "enum": ["Level", "Lever", "Accumulator", "Drifter"],
          "description": "engine node-class; drives runtime dynamics. See reference/taxonomy.md."
        },
        "starting_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "initial value on the fixed 0-100 index"
        },
        "inverted": {
          "type": "boolean",
          "description": "true when a lower value is the desirable state (e.g. a compromise/threat node)"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "sign", "magnitude", "lag", "mechanism"],
      "properties": {
        "id": { "type": "string", "pattern": "^e_", "description": "unique id, 'e_' prefix" },
        "source": { "type": "string", "description": "id of the driving node" },
        "target": { "type": "string", "description": "id of the affected node" },
        "sign": { "type": "string", "enum": ["+", "-"], "description": "direction of influence" },
        "magnitude": {
          "type": "string",
          "enum": ["weak", "moderate", "strong"],
          "description": "qualitative strength bucket (guidance, not a literal multiplier)"
        },
        "lag": {
          "type": "integer",
          "minimum": 0,
          "description": "transport delay in ticks (6 ticks per round). 0-1 immediate, 2-3 short, 6+ multi-round."
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "one specific causal sentence: why source moves target"
        }
      },
      "additionalProperties": true
    }
  }
}
