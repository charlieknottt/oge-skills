{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oge/skills/world-graph-builder/graph.schema.json",
  "title": "OGE World Graph (build-time graph)",
  "description": "The build-time graph (nodes + edges) before runtime state is seeded. The play-ready file is schemas/runtime_graph.schema.json, produced by package_runtime.py. Node values are on the 0-1 scale; edge strength is a 0-1 gain.",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "scenario": { "type": "string", "description": "scenario slug, e.g. gordian_knot" },
    "version": { "type": "string", "description": "graph version string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "label", "category", "type", "baseline", "inverted"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "unique snake_case identifier"
        },
        "label": { "type": "string", "minLength": 1, "description": "human-readable name" },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "functional swimlane grouping (scenario-specific, e.g. Levers/Supply/Outcomes). NOT necessarily a PMESII-P dimension."
        },
        "type": {
          "type": "string",
          "enum": ["Level", "Lever", "Accumulator", "Drifter"],
          "description": "the node's behavior. See guide/1-how-the-model-works.md."
        },
        "baseline": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "resting value on the fixed 0-1 index"
        },
        "inverted": {
          "type": "boolean",
          "description": "true when a lower value is the desirable state (e.g. a compromise/threat node)"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "sign", "strength", "lag", "mechanism"],
      "properties": {
        "id": { "type": "string", "pattern": "^e_", "description": "unique id, 'e_' prefix" },
        "source": { "type": "string", "description": "id of the driving node" },
        "target": { "type": "string", "description": "id of the affected node" },
        "sign": { "type": "string", "enum": ["+", "-"], "description": "direction of influence" },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "edge strength as a 0-1 gain, chosen at graph creation. Bands: weak ~0.2-0.4, moderate ~0.5-0.7, strong ~0.8-1.0. The direction is carried by 'sign'."
        },
        "lag": {
          "type": "integer",
          "minimum": 0,
          "description": "transport delay in ticks (6 ticks per round). 0-1 immediate, 2-3 short, 6+ multi-round."
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "one specific causal sentence: why source moves target"
        }
      },
      "additionalProperties": true
    }
  }
}
